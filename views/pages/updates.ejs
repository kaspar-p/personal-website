<% include ../partials/global %>

<link href="/assets/css/updates.css" rel="stylesheet" type="text/css" />

<script>
  $(document).ready(() => {
    
    function fillTable(tableData) {
        const rowLength = 4;
        // Looping over the rows
        for (rowData of tableData) {
          const row = document.createElement('tr');
          
          // To create the number down the side
          const rowNumber = document.createElement("th");
          rowNumber.appendChild(document.createTextNode(tableData.indexOf(rowData) + 1));
          row.appendChild(rowNumber);

          // Fill each cell in this table with the respective data
          const keys = ["title", "date", "desc"]
          for (let i = 0; i < rowLength - 1; i++) {
            const currentKey = keys[i];
            const cell = document.createElement('td');

            cell.appendChild(document.createTextNode(rowData[currentKey]));
            row.appendChild(cell);
          }

          document.getElementById("tableBody").appendChild(row);
        }

        table.appendChild(tableBody);
        const holder = document.getElementById("tableHolder");
        holder.appendChild(table);
    }

    $
      .ajax({ 
        method: "GET", 
        url: "/api/updates",
      })
      .always(({ data }) => fillTable(data));
  });
</script>

<%- include("../partials/homeButton.ejs", {title: "recent updates"}); %>

<p id="yy" style="display:none"></p>
<% const updates = 2; %>
<div class="container-fluid">
  <div class="custompadding row justify-content-center">
    <div id="tableHolder" class="col-7 text-center">
      <table class="table table-hover updateList text-center">
        <thead>
          <tr align="center">
            <th scope="col">#</th>
            <th scope="col">What happened</th>
            <th scope="col">When it happened</th>
            <th scope="col">Some details</th>
          </tr>
        </thead>
        <tbody id="tableBody">
        </tbody>
      </table>
    </div>
  </div>
</div>
