<% include ../partials/global %>

<link href="/assets/css/updates.css" rel="stylesheet" type="text/css" />

<% const { updates } = data; %>

<%- include("../partials/homeButton.ejs", {title: "recent updates"}); %>

<div class="container-fluid">
  <div class="custompadding row justify-content-center">
    <div class="col-7 text-center">
      <table class="table table-hover updateList text-center">
        <thead>
          <tr align="center">
            <th scope="col">#</th>
            <th scope="col">What happened</th>
            <th scope="col">When it happened</th>
            <th scope="col">Some details</th>
          </tr>
        </thead>
        <tbody>
          <% if (updates != null) { %>
            <% for(let i = 0; i < updates.length; i++) { %>
              <% const item = updates[i]; %>
              <tr> 
                <th class="text-center"><%= i + 1%></th>
                <td class="text-left"><%= item.title %></td>
                <td class="text-center"><%= item.date.toLocaleDateString() %></td>
                <td class="text-left"><%= item.desc%></td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
