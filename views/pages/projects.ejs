<% include ../partials/global %>

<link href="/assets/css/projects.css" rel="stylesheet" type="text/css" />

<% const projects = { 
  doublePendulum: { 
    path: "/double-pendulum.ejs", 
    description: "Double Pendulum Learning Simulation", 
    imagePath: "double-pendulum/headliner.png",
    srcName: "double-pendulum"
  }, 
  reedSolomon: {
    path: "/reed-solomon.ejs",
    description: "On the Construction of Reed-Solomon Codes",
    imagePath: "reed-solomon/headliner.png",
    srcName: "reed-solomon",
  },
}; %>

<% const imagePrePath = "/assets/images/"; %>
<% const projectsAsString = JSON.stringify(projects); %>
<script>

  const getImg = currentScope => $(currentScope).find("a.active").find("img");

  // Necessary to communicate between <script> tags and <% %> tags
  const scriptProjects = JSON.parse('<%- projectsAsString %>');
  const scriptImagePrePath = '<%- imagePrePath %>';
  console.log(scriptProjects);
  // Uses the the old source (/assets/images/reed-solomon/headliner.png) to access the parent object.
  // This fixes a bug that happened while string parsing of images being blahblah.png.png and an error being reached.
  // Access to the parent object, while confusing, guarentees no more parsing bugs.
  const getImagePath = img => {
    const imageSrc = $(img).attr("src"); //i.e. /assets/images/reed-solomon/headliner.png
    const currentSrcName = imageSrc.split("/")[3]; //i.e. reed-solomon

    for (key of Object.keys(scriptProjects)) {
      const propertyNames = Object.getOwnPropertyNames(scriptProjects[key])
      const searchingSrcName = scriptProjects[key][propertyNames[3]]; //reed-solomon or double-pendulum
      const imagePath = scriptProjects[key][propertyNames[2]];
      if (currentSrcName === searchingSrcName) {
        return imagePath[0] === "/" ? imagePath : scriptImagePrePath + imagePath;
      };
    }
  };

  // String parsing on top of perfect result -> no bugs
  const getHoverImagePath = img => {
    const initialImageSrc = getImagePath(img);
    const splitted = initialImageSrc.split(".");
    const result =  splitted[0] + "_hover.png";
    return result;
  };

  const getOldSrc = img => $(img).attr("src");

  $(document).ready(() => {
    $(".carouselImgWrapper")
      .mouseover(
        function() {
          const img = getImg(this);
          // Remove the previous .png and replace it with _hover.png
          const newSrc = getHoverImagePath(img)
          $(img).attr("src", newSrc);
        }
      ) 
      .mouseout(
        function() {
          const img = getImg(this);
          // Remove the _hover.png and replace it with .png
          const newSrc = getImagePath(img);
          $(img).attr("src", newSrc);
        }
      );
  }); 
</script>

<%- include("../partials/homeButton", {title: "projects"}) %>

<div class="carouselWrapper carouselImgWrapper">
 <div id="carouselIndicators" class="carousel slide" data-ride="carousel">
   <ol class="carousel-indicators">
     <% for (let i = 0; i < Object.keys(projects).length; i++) { %>
      <% if (i === 0) { %>
        <li data-target="#carouselIndicators" data-slide-to="<%= i %>" class="active"></li>
      <% } else { %>
        <li data-target="#carouselIndicators" data-slide-to="<%= i %>"></li>
      <% } %>
     <% } %>
   </ol>
   <div class="carousel-inner">
     <% for (let i = 0; i < Object.keys(projects).length; i++) { %>
      <% const project = projects[Object.keys(projects)[i]]; %>
      <% if (i === 0) { %>
        <a class="carousel-item active" href="<%= project.path %>">
          <img class="d-block w-100" src="<%= imagePrePath + project.imagePath %>" alt="Project #<%= i + 1 %>">
          <div class="carousel-caption d-none d-md-block">
            <h5><%= project.description %></h5>
          </div>
        </a>
      <% } else { %>
        <a class="carousel-item" href="<%= project.path %>">
          <img class="d-block w-100" src="<%= imagePrePath + project.imagePath %>" alt="Project #<%= i + 1 %>">
          <div class="carousel-caption d-none d-md-block">
            <h5><%= project.description %></h5>
          </div>
        </a>
      <% } %>
     <% } %>
   </div>
   <a class="carousel-control-prev" href="#carouselIndicators" role="button" data-slide="prev">
     <span class="carousel-control-prev-icon" aria-hidden="true"></span>
     <span class="sr-only">Previous</span>
   </a>
   <a class="carousel-control-next" href="#carouselIndicators" role="button" data-slide="next">
     <span class="carousel-control-next-icon" aria-hidden="true"></span>
     <span class="sr-only">Next</span>
   </a>
 </div>
</div>
