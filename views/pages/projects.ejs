<% include ../partials/global %>

<link href="/assets/css/projects.css" rel="stylesheet" type="text/css" />

<% const projects = { 
  doublePendulum: { 
    path: "/double-pendulum.ejs", 
    description: "Double Pendulum Learning Simulation", 
    imagePath: "doublePendulum/headliner.png",
  }, 
  RSessay: {
    path: "/reed-solomon.ejs",
    description: "On the Construction of Reed-Solomon Codes",
    imagePath: "reed-solomon/headliner.png",
  },
}; %>

<script>

  const getImg = currentScope => $(currentScope).find("a.active").find("img");

  const getOldSrc = img => $(img).attr("src");

  $(document).ready(() => {
    $(".carouselImgWrapper")
      .mouseover(
        function() {
          const img = getImg(this);
          const newSrc = getOldSrc(img).slice(0, getOldSrc(img).length - 4) + "_hover.png";
          $(img).attr("src", newSrc);
        }
      ) 
      .mouseout(
        function() {
          const img = getImg(this);
          const newSrc = getOldSrc(img).split("_")[0] + ".png";
          $(img).attr("src", newSrc);
        }
      );
  }); 
</script>

<%- include("../partials/homeButton", {title: "projects"}) %>

<div class="carouselWrapper carouselImgWrapper">
 <div id="carouselIndicators" class="carousel slide" data-ride="carousel">
   <ol class="carousel-indicators">
     <% for (let i = 0; i < Object.keys(projects).length; i++) { %>
      <% if (i === 0) { %>
        <li data-target="#carouselIndicators" data-slide-to="<%= i %>" class="active"></li>
      <% } else { %>
        <li data-target="#carouselIndicators" data-slide-to="<%= i %>"></li>
      <% } %>
     <% } %>
   </ol>
   <div class="carousel-inner">
     <% for (let i = 0; i < Object.keys(projects).length; i++) { %>
      <% const project = projects[Object.keys(projects)[i]]; %>
      <% if (i === 0) { %>
        <a class="carousel-item active" href="<%= project.path %>">
          <img class="d-block w-100" src="/assets/images/<%= project.imagePath %>" alt="Project #<%= i + 1 %>">
          <div class="carousel-caption d-none d-md-block">
            <h5><%= project.description %></h5>
          </div>
        </a>
      <% } else { %>
        <a class="carousel-item" href="<%= project.path %>">
          <img class="d-block w-100" src="/assets/images/<%= project.imagePath %>" alt="Project #<%= i + 1 %>">
          <div class="carousel-caption d-none d-md-block">
            <h5><%= project.description %></h5>
          </div>
        </a>
      <% } %>
     <% } %>
   </div>
   <a class="carousel-control-prev" href="#carouselIndicators" role="button" data-slide="prev">
     <span class="carousel-control-prev-icon" aria-hidden="true"></span>
     <span class="sr-only">Previous</span>
   </a>
   <a class="carousel-control-next" href="#carouselIndicators" role="button" data-slide="next">
     <span class="carousel-control-next-icon" aria-hidden="true"></span>
     <span class="sr-only">Next</span>
   </a>
 </div>
</div>
