<% include global %>

<link href="/assets/css/homeButton.css" rel="stylesheet" type="text/css" />

<div class="row no-margin headerWrapper">
  <div class="col-auto text-center">
    <a href="../"><h1 class="montserrat-medium fs-2rem buttonsButton homeButton hover-underline">home</h1></a>
  </div>
  <div class="col no-margin no-padding"></div>
  <div class="col-auto text-center">
    <a onclick="history.back(-1)"><h1 class="montserrat-medium fs-2rem buttonsButton backButton hover-underline">back</h1></a>
  </div>
</div>

<div class="row no-margin no-padding">
  <div class="col text-center">
    <% if(typeof(title) !== 'undefined') { %>
      <h1 id="title" class="montserrat-medium"> <%= title %></h1>
    <% } %>
  </div>
</div>
