<link href="/assets/css/contactme.css" rel="stylesheet" type="text/css" />


<a class="col-lg-4 col-md socialBox text-center" href="<%= socialLink %>">
  <div class="row no-margin no-padding">
    <!-- Centers the image on small screens -->
    <div class="col-lg-6 col-md-12 no-margin no-padding imgDiv">
      <img class="logoImg" src="/assets/images/contactme/<%= imageLink %>" />
    </div>
    <div class="col no-margin no-padding socialTitle">
      <h2 class="montserrat-medium socialName"><%= socialName %></h2>
      <h2 class="montserrat-medium socialHandle"><%= handle %></h2>
    </div>
  </div>
</a>
