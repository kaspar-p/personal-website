<% include global %>
<% const rate = 0.6; %>
<% const offset = -12; %>
<% const fromLeftOffset = 55; %>

<link href="/assets/css/squares.css" rel="stylesheet" type="text/css" />

<div class="squareWrapper">
  <% for( let i = 0; i < 20; i++) { %>
    <div class="square" style="left: <%= fromLeftOffset + i %>%; animation-delay: <%= (offset + rate * i) %>s">
      <img class="customImg" src="/assets/images/blackCi.png" height="40" width="40" />
    </div>
  <% } %>
</div>
